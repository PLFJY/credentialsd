{
    "description": "Helper to integrate credentialsd with the browser",
    "manifest_version": 3,
    "name": "credentialsd-helper",
    "version": "0.1.0",
    "icons": {
        "48": "icons/logo.svg"
    },
    "browser_specific_settings": {
        "gecko": {
            "id": "credentialsd-sidecar@plfjy.top",
            "strict_min_version": "140.0",
            "update_url": "https://github.com/PLFJY/credentialsd/releases/latest/download/updates.json",
            "data_collection_permissions": {
                "required": [
                    "authenticationInfo",
                    "browsingActivity",
                    "websiteContent"
                ]
            }
        }
    },
    "background": {
        "scripts": [
            "background.js"
        ]
    },
    "content_scripts": [
        {
            "matches": [
                "https://*/*"
            ],
            "js": [
                "content-bridge.js"
            ],
            "run_at": "document_start",
            "world": "ISOLATED"
        },
        {
            "matches": [
                "https://*/*"
            ],
            "js": [
                "content-main.js"
            ],
            "run_at": "document_start",
            "world": "MAIN"
        }
    ],
    "action": {
        "default_icon": "icons/logo.svg"
    },
    "permissions": [
        "nativeMessaging"
    ]
}
