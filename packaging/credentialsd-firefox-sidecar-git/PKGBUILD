# Maintainer: PLFJY <plfjy@localhost>
#
# All-in-one Firefox Hybrid QR Passkey sidecar package.
#
# Builds from two GitHub forks:
#   - PLFJY/credentialsd (integration/credential-portal-sidecar branch)
#   - PLFJY/xdg-desktop-portal (sidecar/credential-portal branch)
#
# Installs the native Linux integration only:
#   - credentialsd daemon + UI + D-Bus services + systemd units
#   - Credential Portal sidecar frontend (io.github.PLFJY.CredentialPortal)
#   - Firefox Native Messaging shim + manifest
#   - schemas, icons, locale and required runtime data
#
# This package does NOT install the Firefox extension itself. The Mozilla-signed
# Firefox XPI is distributed only through GitHub Releases:
#
#   https://github.com/PLFJY/credentialsd/releases/latest
#
# To permanently install the Firefox extension, download the signed XPI from the
# latest GitHub Release and install it via:
#   Firefox → about:addons → gear menu → Install Add-on From File…
#
# For development only, an unsigned XPI is generated by the Meson build under
# the build directory and may be loaded temporarily through about:debugging.
# That unsigned XPI is never installed into /usr by this package.
#
# Post-install checklist:
#   1. systemctl --user daemon-reload
#   2. systemctl --user start credentials-portal-sidecar.service
#   3. systemctl --user start xyz.iinuwa.credentialsd.UiControl.service
#   4. Download the signed XPI from the latest GitHub Release
#   5. Firefox → about:addons → gear menu → Install Add-on From File…
#   6. Verify: gdbus introspect --session --dest io.github.PLFJY.CredentialPortal \
#        --object-path /org/freedesktop/portal/desktop | grep credential

pkgname=credentialsd-firefox-sidecar-git
pkgver=r1
pkgrel=2
pkgdesc='credentialsd + Credential Portal sidecar + Firefox Native Messaging integration'
arch=('x86_64')
url='https://github.com/PLFJY/credentialsd'
license=('LGPL-3.0-only' 'LGPL-2.1-or-later')
# Disable LTO: makepkg's default OPTIONS=(lto) appends -flto=auto to CFLAGS,
# which causes ring's C/asm objects to fail linking under rust-lld.
options=(!lto)

depends=(
  'dbus'
  'glib2'
  'gtk4'
  'openssl'
  'systemd-libs'
  'pcsclite'
  'libnfc'
  'hidapi'
  'hicolor-icon-theme'
  'json-glib'
  'fuse3'
  'gdk-pixbuf2'
  'gst-plugins-base-libs'
  'libpipewire'
  'libwireplumber'
  'libdex'
  'geoclue'
  'systemd'
  'python-dbus-next'
)

makedepends=(
  'meson'
  'ninja'
  'rust'
  'git'
  'cargo'
  'zip'
  'pkgconf'
  'gettext'
)

source=(
  "credentialsd::git+https://github.com/PLFJY/credentialsd.git#branch=integration/credential-portal-sidecar"
  "xdg-desktop-portal::git+https://github.com/PLFJY/xdg-desktop-portal.git#branch=sidecar/credential-portal"
)
sha256sums=('SKIP' 'SKIP')

pkgver() {
  cd "$srcdir/credentialsd"
  printf "r%s.%s" "$(git rev-list --count HEAD)" "$(git rev-parse --short HEAD)"
}

build() {
  # --- Build xdg-desktop-portal sidecar frontend ---
  cd "$srcdir/xdg-desktop-portal"
  meson setup build --prefix=/usr \
    --libexecdir=/usr/lib \
    -Dportal_bus_name=io.github.PLFJY.CredentialPortal \
    -Dportal_binary_name=credentials-portal-sidecar \
    -Dportal_systemd_unit_name=credentials-portal-sidecar.service \
    -Dportal_dbus_service_name=io.github.PLFJY.CredentialPortal.service \
    -Dsidecar_install=true \
    -Dgeoclue=enabled \
    -Dgudev=disabled \
    -Dflatpak-interfaces=disabled \
    -Dsystemd=enabled \
    -Dtests=disabled \
    -Ddocumentation=disabled \
    -Dman-pages=disabled
  ninja -C build

  # --- Build credentialsd with sidecar-targeted webextension ---
  cd "$srcdir/credentialsd"
  meson setup build --prefix=/usr \
    -Dprofile=default \
    -Dfirefox_portal_bus_name=io.github.PLFJY.CredentialPortal \
    -Dcargo_locked=true \
    -Dcargo_lto=false
  ninja -C build
}

package() {
  # Install xdg-desktop-portal sidecar frontend
  cd "$srcdir/xdg-desktop-portal"
  meson install -C build --destdir="$pkgdir"

  # Install credentialsd (daemon + UI + webext + portal config). The Meson
  # install also produces unsigned browser extension archives under
  # $pkgdir/usr/share/credentialsd/; they are removed below because the
  # Mozilla-signed Firefox XPI is distributed only through GitHub Releases.
  cd "$srcdir/credentialsd"
  meson install -C build --destdir="$pkgdir"

  # Remove browser extension archives from the package root. The Mozilla-signed
  # Firefox XPI is distributed only through GitHub Releases; no Arch package
  # installs an XPI or a Chromium extension ZIP into /usr. Safe quoting is used
  # and the operation succeeds even when a file is absent (rm -f).
  rm -f "$pkgdir/usr/share/credentialsd/credentialsd-firefox-helper.xpi"
  rm -f "$pkgdir/usr/share/credentialsd/credentialsd-firefox-helper-unsigned.xpi"
  rm -f "$pkgdir/usr/share/credentialsd/credentialsd-chromium-helper.zip"

  # Defense-in-depth: assert no browser extension archives remain anywhere in
  # the package root. If any *.xpi or *chromium*.zip file is found, fail the
  # package() step rather than ship an unsigned archive into /usr.
  if find "$pkgdir" -type f \( -name '*.xpi' -o -name '*chromium*.zip' \) -print -quit | grep -q .; then
    error "Browser extension archive unexpectedly remained in package root"
    return 1
  fi

  # Licenses
  install -Dm644 "$srcdir/credentialsd/LICENSE.md" \
    "$pkgdir/usr/share/licenses/$pkgname/credentialsd-LICENSE.md"
  install -Dm644 "$srcdir/xdg-desktop-portal/LICENSES/LGPL-2.1-or-later.txt" \
    "$pkgdir/usr/share/licenses/$pkgname/xdp-LGPL-2.1.txt"
}
