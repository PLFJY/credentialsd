# Maintainer: PLFJY <plfjy@localhost>
#
# Firefox/Chromium webextension surface for credentialsd, built from the
# integration/credential-portal-sidecar branch and targeted at the
# io.github.PLFJY.CredentialPortal sidecar frontend via
# -Dfirefox_portal_bus_name.
#
# DEVELOPMENT-ONLY: the bundled credentialsd-firefox-helper.xpi is UNSIGNED.
# It must be loaded through Firefox's temporary/debugging add-on workflow or a
# developer build channel; it will not install as a regular signed add-on.
#
# This package keeps ONLY the webextension surface (helper shim, Native
# Messaging manifest, XPI, Chromium zip). The daemon/UI ship in
# credentialsd-git. Package roots are disjoint. This package does not mutate any
# Firefox profile, start Firefox, start ceremonies, or enable global services.

pkgname=credentialsd-webextension-sidecar-git
pkgver=0.1.0
pkgrel=1
pkgdesc='Firefox/Chromium webextension shim for credentialsd (sidecar-targeted, unsigned development build)'
arch=('x86_64')
url='https://github.com/linux-credentials/credentialsd'
license=('LGPL-3.0-only')
# Disable LTO for the same reason as credentialsd-git: makepkg's -flto=auto in
# CFLAGS breaks ring's C/asm link step under rust-lld.
options=(!lto)
depends=('python-dbus-next' 'credentialsd-git')
makedepends=(
  'meson'
  'ninja'
  'rust'
  'git'
  'cargo'
  'zip'
  'pkgconf'
  'systemd'
  'gettext'
  'dbus'
  'glib2'
  'gtk4'
  'openssl'
  'pcsclite'
  'libnfc'
  'hidapi'
)
source=("$pkgname::git+file:///home/plfjy/credentialsd-sidecar#branch=integration/credential-portal-sidecar")
sha256sums=('SKIP')

pkgver() {
  cd "$srcdir/$pkgname"
  printf "r%s.%s" "$(git rev-list --count HEAD)" "$(git rev-parse --short HEAD)"
}

build() {
  cd "$srcdir/$pkgname"
  meson setup build --prefix=/usr \
    -Dprofile=default \
    -Dfirefox_portal_bus_name=io.github.PLFJY.CredentialPortal \
    -Dcargo_locked=true \
    -Dcargo_lto=false \
    -Dcargo_home=/home/plfjy/.cargo
  ninja -C build
}

package() {
  cd "$srcdir/$pkgname"
  # Perform a full install into a throwaway staging root, then keep ONLY the
  # webextension surface in $pkgdir. This keeps package roots disjoint from
  # credentialsd-git and avoids touching the live system during package().
  local staging="$srcdir/staging"
  rm -rf "$staging"
  meson install -C build --destdir="$staging"

  install -Dm755 "$staging/usr/bin/credentialsd-firefox-helper" \
    "$pkgdir/usr/bin/credentialsd-firefox-helper"
  install -Dm644 "$staging/usr/lib/mozilla/native-messaging-hosts/xyz.iinuwa.credentialsd_helper.json" \
    "$pkgdir/usr/lib/mozilla/native-messaging-hosts/xyz.iinuwa.credentialsd_helper.json"
  install -Dm644 "$staging/usr/share/credentialsd/credentialsd-firefox-helper.xpi" \
    "$pkgdir/usr/share/credentialsd/credentialsd-firefox-helper.xpi"
  install -Dm644 "$staging/usr/share/credentialsd/credentialsd-chromium-helper.zip" \
    "$pkgdir/usr/share/credentialsd/credentialsd-chromium-helper.zip"

  install -Dm644 LICENSE.md \
    "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
}
